{
    "name": "sillytavern-tests",
    "type": "module",
    "license": "AGPL-3.0",
    "scripts": {
        "test": "npm run test:unit && npm run test:e2e && npm run test:browser",
        "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.mjs",
        "test:gate": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.mjs storage-provider-boot-gate",
        "test:integration:vault": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.vault.json",
        "test:integration:mnemosyne": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.mnemosyne.json",
        "test:e2e": "playwright test",
        "test:browser": "node run-browser-specs.mjs",
        "lint": "eslint \"**/*.js\" ./*.js",
        "lint:fix": "eslint \"**/*.js\" ./*.js --fix"
    },
    "dependencies": {
        "@playwright/test": "^1.56.1",
        "@types/jest": "^29.5.12",
        "eslint": "^8.57.0",
        "jest": "^29.7.0"
    }
}
